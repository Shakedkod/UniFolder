{
  "name": "@mdtolatex/obsidian-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian plugin that converts the active note to LaTeX using @mdtolatex/core",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@mdtolatex/core": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2"
  }
}
